# Один обнаруженный объект на кадре.
#
# Координаты центра нормированы в диапазон [-1, 1]:
#   x: -1 = левый край кадра, +1 = правый край, 0 = центр по горизонтали
#   y: -1 = нижний край кадра, +1 = верхний край, 0 = центр по вертикали
# (то есть ось Y направлена ВВЕРХ, как в математике, а не как в пикселях изображения)
float32 x
float32 y

# Уверенность модели [0, 1].
float32 confidence

# Размер рамки объекта как доля кадра [0, 1] (удобно как грубая оценка дистанции).
float32 width
float32 height
