<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>op3_football</name>
  <version>0.1.0</version>
  <description>OP3 football stack L2/L3/L4 Python API</description>
  <maintainer email="robotis@todo.todo">robotis</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>op3_football_msgs</depend>
  <depend>op3_walking_module_msgs</depend>
  <depend>op3_ball_detector_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
